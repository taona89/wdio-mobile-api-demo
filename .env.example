# Copy to .env and fill in. .env is gitignored.

# Serial of your phone from `adb devices`. Optional with exactly one device connected;
# with several, Appium would otherwise pick the first one adb lists.
ANDROID_UDID=

# API tests target the public Restful Booker by default.
# API_BASE_URL=https://restful-booker.herokuapp.com

# Restful Booker's documented admin account (defaults shown).
# BOOKER_USERNAME=admin
# BOOKER_PASSWORD=password123
