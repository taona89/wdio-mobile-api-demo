{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "@wdio/globals/types", "@wdio/cucumber-framework", "expect-webdriverio"]
    },
    "include": ["config/**/*.ts", "pages/**/*.ts", "steps/**/*.ts", "support/**/*.ts", "data/**/*.ts"]
}
